{
    "scopeName": "bino.query.injection",
    "injectionSelector": "L:source.yaml -comment -string -meta.embedded",
    "patterns": [
        {
            "include": "#query-block"
        },
        {
            "include": "#query-double-quoted"
        },
        {
            "include": "#query-single-quoted"
        },
        {
            "include": "#query-plain"
        },
        {
            "include": "#prql-block"
        },
        {
            "include": "#prql-double-quoted"
        },
        {
            "include": "#prql-single-quoted"
        },
        {
            "include": "#prql-plain"
        }
    ],
    "repository": {
        "query-block": {
            "begin": "(?<=^([ ]*))(query)[ \\t]*(:)[ \\t]+([|>][1-9]?[-+]?|[-+][1-9]?[|>]|[1-9][-+]?[|>])[ \\t]*(#.*)?$",
            "beginCaptures": {
                "2": {
                    "name": "entity.name.tag.yaml"
                },
                "3": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "4": {
                    "name": "keyword.control.flow.block-scalar.yaml"
                },
                "5": {
                    "name": "comment.line.number-sign.yaml"
                }
            },
            "while": "^(?=\\1[ ]+\\S|[ \\t]*$)|(?<=^\\1)\\G(?=[ ]+\\S|[ \\t]*$)",
            "contentName": "meta.embedded.block.sql",
            "patterns": [
                {
                    "include": "source.sql"
                }
            ]
        },
        "query-double-quoted": {
            "match": "(?<![\\w-])(query)[ \\t]*(:)[ \\t]+(\")((?:[^\"\\\\]|\\\\.)*)(\")",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.yaml"
                },
                "4": {
                    "name": "meta.embedded.line.sql",
                    "patterns": [
                        {
                            "include": "source.sql"
                        }
                    ]
                },
                "5": {
                    "name": "punctuation.definition.string.end.yaml"
                }
            }
        },
        "query-single-quoted": {
            "match": "(?<![\\w-])(query)[ \\t]*(:)[ \\t]+(')((?:[^']|'')*)(')",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.yaml"
                },
                "4": {
                    "name": "meta.embedded.line.sql",
                    "patterns": [
                        {
                            "include": "source.sql"
                        }
                    ]
                },
                "5": {
                    "name": "punctuation.definition.string.end.yaml"
                }
            }
        },
        "query-plain": {
            "match": "(?<![\\w-])(query)[ \\t]*(:)[ \\t]+((?![|>\\\"'&*!{\\[#%@`])[^#\\n]*?)(?=[ \\t]+#|[ \\t]*$)",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "meta.embedded.line.sql",
                    "patterns": [
                        {
                            "include": "source.sql"
                        }
                    ]
                }
            }
        },
        "prql-block": {
            "begin": "(?<=^([ ]*))(prql)[ \\t]*(:)[ \\t]+([|>][1-9]?[-+]?|[-+][1-9]?[|>]|[1-9][-+]?[|>])[ \\t]*(#.*)?$",
            "beginCaptures": {
                "2": {
                    "name": "entity.name.tag.yaml"
                },
                "3": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "4": {
                    "name": "keyword.control.flow.block-scalar.yaml"
                },
                "5": {
                    "name": "comment.line.number-sign.yaml"
                }
            },
            "while": "^(?=\\1[ ]+\\S|[ \\t]*$)|(?<=^\\1)\\G(?=[ ]+\\S|[ \\t]*$)",
            "contentName": "meta.embedded.block.prql",
            "patterns": [
                {
                    "include": "source.prql.bino"
                }
            ]
        },
        "prql-double-quoted": {
            "match": "(?<![\\w-])(prql)[ \\t]*(:)[ \\t]+(\")((?:[^\"\\\\]|\\\\.)*)(\")",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.yaml"
                },
                "4": {
                    "name": "meta.embedded.line.prql",
                    "patterns": [
                        {
                            "include": "source.prql.bino"
                        }
                    ]
                },
                "5": {
                    "name": "punctuation.definition.string.end.yaml"
                }
            }
        },
        "prql-single-quoted": {
            "match": "(?<![\\w-])(prql)[ \\t]*(:)[ \\t]+(')((?:[^']|'')*)(')",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "punctuation.definition.string.begin.yaml"
                },
                "4": {
                    "name": "meta.embedded.line.prql",
                    "patterns": [
                        {
                            "include": "source.prql.bino"
                        }
                    ]
                },
                "5": {
                    "name": "punctuation.definition.string.end.yaml"
                }
            }
        },
        "prql-plain": {
            "match": "(?<![\\w-])(prql)[ \\t]*(:)[ \\t]+((?![|>\\\"'&*!{\\[#%@`])[^#\\n]*?)(?=[ \\t]+#|[ \\t]*$)",
            "captures": {
                "1": {
                    "name": "entity.name.tag.yaml"
                },
                "2": {
                    "name": "punctuation.separator.key-value.mapping.yaml"
                },
                "3": {
                    "name": "meta.embedded.line.prql",
                    "patterns": [
                        {
                            "include": "source.prql.bino"
                        }
                    ]
                }
            }
        }
    }
}

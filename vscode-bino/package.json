{
  "name": "vscode-bino",
  "displayName": "Bino Reports",
  "description": "Enhanced YAML editing for Bino report manifests with intelligent autocompletion",
  "version": "0.25.0",
  "license": "AGPL-3.0-or-later",
  "publisher": "BinoBI",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bino-bi/bino-cli-releases"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "yaml",
    "bino",
    "reports",
    "data"
  ],
  "activationEvents": [
    "workspaceContains:**/bino.toml",
    "onView:binoGettingStarted"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Bino runs the SQL and YAML in the workspace, so the daemon, language server, preview and builds start only once the workspace is trusted.",
      "restrictedConfigurations": [
        "bino.binPath"
      ]
    }
  },
  "contributes": {
    "tomlValidation": [
      {
        "fileMatch": "bino.toml",
        "url": "https://cli.bino.bi/schemas/bino-toml.schema.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "bino.designer",
        "displayName": "Bino Designer",
        "selector": [
          { "filenamePattern": "*.yaml" },
          { "filenamePattern": "*.yml" }
        ],
        "priority": "option"
      },
      {
        "viewType": "bino.treeEditor",
        "displayName": "Bino Tree Editor",
        "selector": [
          { "filenamePattern": "*.yaml" },
          { "filenamePattern": "*.yml" }
        ],
        "priority": "option"
      },
      {
        "viewType": "bino.styleEditor",
        "displayName": "Bino ComponentStyle Editor",
        "selector": [
          { "filenamePattern": "*.yaml" },
          { "filenamePattern": "*.yml" }
        ],
        "priority": "option"
      },
      {
        "viewType": "bino.ruleSetEditor",
        "displayName": "Bino RuleSet Editor",
        "selector": [
          { "filenamePattern": "*.yaml" },
          { "filenamePattern": "*.yml" }
        ],
        "priority": "option"
      }
    ],
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/annotations.code-snippets"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "bino",
        "label": "Bino"
      }
    ],
    "grammars": [
      {
        "scopeName": "bino.query.injection",
        "path": "./syntaxes/bino-query.injection.json",
        "injectTo": [
          "source.yaml"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.sql": "sql",
          "meta.embedded.line.sql": "sql"
        }
      },
      {
        "scopeName": "source.prql.bino",
        "path": "./syntaxes/prql.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bino",
          "title": "Bino Reports",
          "icon": "resources/bino-activity-bar.svg"
        }
      ]
    },
    "views": {
      "bino": [
        {
          "id": "binoGettingStarted",
          "name": "Getting Started",
          "when": "!bino.projectDetected"
        },
        {
          "id": "binoDocuments",
          "name": "Documents",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoPreview",
          "name": "Preview & Build",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoDependencies",
          "name": "Dependencies",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoEnvironment",
          "name": "Environment",
          "when": "bino.projectDetected"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "binoGettingStarted",
        "contents": "No Bino project detected.\n[Initialize Project](command:bino.initProject)\n[Check Setup](command:bino.checkSetup)\n[Open Folder](command:vscode.openFolder)",
        "when": "isWorkspaceTrusted"
      },
      {
        "view": "binoGettingStarted",
        "contents": "Bino features need a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)",
        "when": "!isWorkspaceTrusted"
      }
    ],
    "commands": [
      {
        "command": "bino.registrySearch",
        "title": "Add Dependency from Registry…",
        "category": "Bino",
        "icon": "$(search)"
      },
      {
        "command": "bino.registryInstall",
        "title": "Install Dependencies from Lockfile",
        "category": "Bino",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bino.registryUpdateAll",
        "title": "Update All Dependencies",
        "category": "Bino",
        "icon": "$(sync)"
      },
      {
        "command": "bino.registryUpdatePackage",
        "title": "Update Package",
        "category": "Bino",
        "icon": "$(sync)"
      },
      {
        "command": "bino.registryRemovePackage",
        "title": "Remove Package",
        "category": "Bino",
        "icon": "$(trash)"
      },
      {
        "command": "bino.registryOpenPackageFile",
        "title": "Open Installed File",
        "category": "Bino",
        "icon": "$(go-to-file)"
      },
      {
        "command": "bino.registryCopyRef",
        "title": "Copy Component Reference",
        "category": "Bino",
        "icon": "$(clippy)"
      },
      {
        "command": "bino.registryInsertRef",
        "title": "Insert Component Reference…",
        "category": "Bino",
        "icon": "$(insert)"
      },
      {
        "command": "bino.registryRefresh",
        "title": "Refresh Dependencies",
        "category": "Bino",
        "icon": "$(refresh)"
      },
      {
        "command": "bino.registryLogin",
        "title": "Registry Login",
        "category": "Bino",
        "icon": "$(sign-in)"
      },
      {
        "command": "bino.registryLogout",
        "title": "Registry Logout",
        "category": "Bino",
        "icon": "$(sign-out)"
      },
      {
        "command": "bino.registryPublish",
        "title": "Publish Package",
        "category": "Bino",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bino.newDataSourceFromFile",
        "title": "New DataSource from File…",
        "category": "Bino",
        "icon": "$(database)"
      },
      {
        "command": "bino.newDataSourceFromDatabase",
        "title": "New DataSource from Database…",
        "category": "Bino",
        "icon": "$(database)"
      },
      {
        "command": "bino.restartDaemon",
        "title": "Restart Daemon",
        "category": "Bino",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bino.selectProject",
        "title": "Switch Project...",
        "category": "Bino"
      },
      {
        "command": "bino.refreshIndex",
        "title": "Refresh Index",
        "category": "Bino",
        "icon": "$(refresh)"
      },
      {
        "command": "bino.openDocument",
        "title": "Open Document",
        "category": "Bino"
      },
      {
        "command": "bino.openInlineChild",
        "title": "Open Component",
        "category": "Bino"
      },
      {
        "command": "bino.startPreview",
        "title": "Start Preview",
        "category": "Bino",
        "icon": "$(play)"
      },
      {
        "command": "bino.stopPreview",
        "title": "Stop Preview",
        "category": "Bino",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bino.restartPreview",
        "title": "Restart Preview",
        "category": "Bino",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bino.openPreviewInBrowser",
        "title": "Open Preview in Browser",
        "category": "Bino",
        "icon": "$(link-external)"
      },
      {
        "command": "bino.openPreviewInWebview",
        "title": "Open Preview in Webview",
        "category": "Bino",
        "icon": "$(window)"
      },
      {
        "command": "bino.previewMenu",
        "title": "Preview Menu",
        "category": "Bino"
      },
      {
        "command": "bino.build",
        "title": "Build Report",
        "category": "Bino",
        "icon": "$(package)"
      },
      {
        "command": "bino.checkSetup",
        "title": "Check Setup",
        "category": "Bino",
        "icon": "$(info)"
      },
      {
        "command": "bino.downloadBino",
        "title": "Download bino",
        "category": "Bino",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bino.showColumnsForCurrentDataset",
        "title": "Show Columns for Current Dataset/DataSource",
        "category": "Bino",
        "icon": "$(list-flat)"
      },
      {
        "command": "bino.openFirstProblem",
        "title": "Go to First Problem",
        "category": "Bino",
        "icon": "$(error)"
      },
      {
        "command": "bino.showGraphForItem",
        "title": "Show Graph (Dependencies & Dependents)",
        "category": "Bino",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bino.showDependenciesForItem",
        "title": "Show Dependencies",
        "category": "Bino",
        "icon": "$(arrow-down)"
      },
      {
        "command": "bino.showDependentsForItem",
        "title": "Show Dependents (What Uses This?)",
        "category": "Bino",
        "icon": "$(arrow-up)"
      },
      {
        "command": "bino.openPrqlEditor",
        "title": "Open PRQL Editor",
        "category": "Bino",
        "icon": "$(code)"
      },
      {
        "command": "bino.openPrqlSqlPreview",
        "title": "Open PRQL SQL Preview",
        "category": "Bino",
        "icon": "$(open-preview)"
      },
      {
        "command": "bino.previewRows",
        "title": "Preview Rows (100 rows)",
        "category": "Bino",
        "icon": "$(preview)"
      },
      {
        "command": "bino.openTreeEditor",
        "title": "Open Tree Editor",
        "category": "Bino",
        "icon": "$(list-tree)"
      },
      {
        "command": "bino.openStyleEditor",
        "title": "Open ComponentStyle Editor",
        "category": "Bino",
        "icon": "$(paintcan)"
      },
      {
        "command": "bino.openRuleSetEditor",
        "title": "Open RuleSet Editor",
        "category": "Bino",
        "icon": "$(checklist)"
      },
      {
        "command": "bino.openDesigner",
        "title": "Open Designer",
        "category": "Bino",
        "icon": "$(edit)"
      },
      {
        "command": "bino.openInDesigner",
        "title": "Open in Designer",
        "category": "Bino",
        "icon": "$(edit)"
      },
      {
        "command": "bino.addElement",
        "title": "Add Element",
        "category": "Bino",
        "icon": "$(add)"
      },
      {
        "command": "bino.initProject",
        "title": "Initialize Project",
        "category": "Bino"
      },
      {
        "command": "bino.cacheClean",
        "title": "Clean Cache",
        "category": "Bino"
      },
      {
        "command": "bino.cacheCleanGlobal",
        "title": "Clean Cache (Global)",
        "category": "Bino"
      },
      {
        "command": "bino.buildArtefact",
        "title": "Build Specific Artefact",
        "category": "Bino"
      },
      {
        "command": "bino.previewArtefactEmbedded",
        "title": "Preview (Embedded)",
        "category": "Bino",
        "icon": "$(preview)"
      },
      {
        "command": "bino.validateWithQueries",
        "title": "Validate with Queries",
        "category": "Bino"
      },
      {
        "command": "bino.showGraphTree",
        "title": "Show Graph (Tree)",
        "category": "Bino"
      },
      {
        "command": "bino.showGraphFlat",
        "title": "Show Graph (Flat)",
        "category": "Bino"
      },
      {
        "command": "bino.openSettings",
        "title": "Open Bino Settings",
        "category": "Bino"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bino.addElement",
          "when": "view == binoDocuments",
          "group": "navigation@0"
        },
        {
          "command": "bino.refreshIndex",
          "when": "view == binoDocuments",
          "group": "navigation@1"
        },
        {
          "command": "bino.registrySearch",
          "when": "view == binoDependencies",
          "group": "navigation@0"
        },
        {
          "command": "bino.registryUpdateAll",
          "when": "view == binoDependencies",
          "group": "navigation@1"
        },
        {
          "command": "bino.registryPublish",
          "when": "view == binoDependencies",
          "group": "navigation@2"
        },
        {
          "command": "bino.registryRefresh",
          "when": "view == binoDependencies",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "bino.newDataSourceFromFile",
          "when": "bino.projectDetected && resourceExtname =~ /\\.(csv|tsv|xlsx|xls|parquet)$/i",
          "group": "bino@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bino.openStyleEditor",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.openRuleSetEditor",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registrySearch",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryInstall",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryUpdateAll",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryInsertRef",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryLogin",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryLogout",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryPublish",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryRefresh",
          "when": "false"
        },
        {
          "command": "bino.registryUpdatePackage",
          "when": "false"
        },
        {
          "command": "bino.registryRemovePackage",
          "when": "false"
        },
        {
          "command": "bino.registryOpenPackageFile",
          "when": "false"
        },
        {
          "command": "bino.registryCopyRef",
          "when": "false"
        },
        {
          "command": "bino.newDataSourceFromFile",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.newDataSourceFromDatabase",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.addElement",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.openInDesigner",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.restartDaemon",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.selectProject",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.openDocument",
          "when": "false"
        },
        {
          "command": "bino.openInlineChild",
          "when": "false"
        },
        {
          "command": "bino.previewMenu",
          "when": "false"
        },
        {
          "command": "bino.openFirstProblem",
          "when": "false"
        },
        {
          "command": "bino.openPrqlEditor",
          "when": "editorLangId == yaml"
        },
        {
          "command": "bino.openPrqlSqlPreview",
          "when": "editorLangId == yaml"
        },
        {
          "command": "bino.showGraphForItem",
          "when": "false"
        },
        {
          "command": "bino.showDependenciesForItem",
          "when": "false"
        },
        {
          "command": "bino.showDependentsForItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "bino.openStyleEditor",
          "when": "view == binoDocuments && viewItem == binoDocumentComponentStyle",
          "group": "preview@2"
        },
        {
          "command": "bino.openRuleSetEditor",
          "when": "view == binoDocuments && viewItem == binoDocumentRuleSet",
          "group": "preview@2"
        },
        {
          "command": "bino.previewArtefactEmbedded",
          "when": "view == binoDocuments && viewItem == binoArtefact",
          "group": "preview@1"
        },
        {
          "command": "bino.openDesigner",
          "when": "view == binoDocuments && viewItem == binoArtefact",
          "group": "preview@2"
        },
        {
          "command": "bino.openFirstProblem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)/",
          "group": "navigation"
        },
        {
          "command": "bino.showGraphForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)/",
          "group": "graph@1"
        },
        {
          "command": "bino.showDependenciesForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)/",
          "group": "graph@2"
        },
        {
          "command": "bino.showDependentsForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)/",
          "group": "graph@3"
        },
        {
          "command": "bino.registryInsertRef",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@1"
        },
        {
          "command": "bino.registryCopyRef",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@2"
        },
        {
          "command": "bino.registryOpenPackageFile",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@3"
        },
        {
          "command": "bino.registryInstall",
          "when": "view == binoDependencies && viewItem == binoPackageNotInstalled",
          "group": "manage@0"
        },
        {
          "command": "bino.registryUpdatePackage",
          "when": "view == binoDependencies && viewItem =~ /^binoPackage(NotInstalled)?$/",
          "group": "manage@1"
        },
        {
          "command": "bino.registryRemovePackage",
          "when": "view == binoDependencies && viewItem =~ /^binoPackage(NotInstalled)?$/",
          "group": "manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "bino.openTreeEditor",
          "when": "editorLangId == yaml && bino.projectDetected",
          "group": "navigation"
        },
        {
          "command": "bino.openStyleEditor",
          "when": "editorLangId == yaml && bino.projectDetected && bino.activeHasComponentStyle",
          "group": "navigation"
        },
        {
          "command": "bino.openRuleSetEditor",
          "when": "editorLangId == yaml && bino.projectDetected && bino.activeHasRuleSet",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bino.openInDesigner",
          "when": "editorLangId == yaml && bino.projectDetected",
          "group": "bino@0"
        },
        {
          "command": "bino.openPrqlEditor",
          "when": "editorLangId == yaml && bino.inPrqlBlock",
          "group": "bino@1"
        },
        {
          "command": "bino.openPrqlSqlPreview",
          "when": "editorLangId == yaml && bino.inPrqlBlock",
          "group": "bino@2"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "bino",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build"
            ],
            "description": "The bino command to run."
          },
          "artefact": {
            "type": "string",
            "description": "metadata.name of the artefact to build. Builds all artefacts when not set."
          }
        }
      }
    ],
    "walkthroughs": [
      {
        "id": "binoGettingStarted",
        "title": "Get Started with Bino",
        "description": "Install bino, create a project, add data and preview your first report.",
        "steps": [
          {
            "id": "installBino",
            "title": "Install bino",
            "description": "The extension needs the bino command line tool.\n[Check for bino](command:bino.checkSetup)\n[Download bino](command:bino.downloadBino)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onContext:bino.binoInstalled"
            ]
          },
          {
            "id": "initProject",
            "title": "Create a project",
            "description": "Run bino init to create bino.toml and a first report.\n[Initialize Project](command:bino.initProject)",
            "media": {
              "markdown": "media/walkthrough/init.md"
            },
            "completionEvents": [
              "onCommand:bino.initProject"
            ]
          },
          {
            "id": "addDataSource",
            "title": "Add a DataSource",
            "description": "Point bino at a file or a database with the DataSource wizard.\n[Open the DataSource wizard](command:bino.newDataSourceFromDatabase)",
            "media": {
              "markdown": "media/walkthrough/datasource.md"
            },
            "completionEvents": [
              "onCommand:bino.newDataSourceFromDatabase",
              "onCommand:bino.newDataSourceFromFile"
            ]
          },
          {
            "id": "startPreview",
            "title": "Preview the report",
            "description": "Start the live preview. It reloads when you save.\n[Start Preview](command:bino.startPreview)",
            "media": {
              "markdown": "media/walkthrough/preview.md"
            },
            "completionEvents": [
              "onCommand:bino.startPreview"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Bino Reports",
      "properties": {
        "bino.binPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bino CLI executable. If not set, uses 'bino' from PATH, then a bino downloaded by the extension."
        },
        "bino.columnCacheTTL": {
          "type": "number",
          "default": 60000,
          "description": "Time in milliseconds to cache column introspection results (default: 60 seconds)."
        },
        "bino.previewPort": {
          "type": "number",
          "default": 45678,
          "description": "Port number for the bino preview server."
        },
        "bino.daemon.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent background daemon for faster indexing, validation, and data introspection. The daemon shares a single DuckDB session across operations."
        },
        "bino.lsp.queryDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Check the queries of a DataSet with DuckDB when you save the file, and show parse and bind errors on the query lines. Runs each query with LIMIT 0, so it reads no rows, but it may still open remote sources."
        },
        "bino.wizard.sampleRowLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of sample rows the DataSource wizard fetches when introspecting a source."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p .",
    "pretest": "tsc -p . --outDir out",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",

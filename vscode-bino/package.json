      },
      {
        "command": "bino.registryUpdatePackage",
        "title": "Update Package",
        "category": "Bino",
        "icon": "$(sync)"
      },
      {
        "command": "bino.registryRemovePackage",
        "title": "Remove Package",
        "category": "Bino",
        "icon": "$(trash)"
      },
      {
        "command": "bino.registryOpenPackageFile",
        "title": "Open Installed File",

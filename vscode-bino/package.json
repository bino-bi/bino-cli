        "title": "Refresh Dependencies",
        "category": "Bino",
        "icon": "$(refresh)"
      },
      {
        "command": "bino.registryLogin",
        "title": "Registry Login",
        "category": "Bino",
        "icon": "$(sign-in)"
      },
      {
        "command": "bino.registryLogout",
        "title": "Registry Logout",
        "category": "Bino",
        "icon": "$(sign-out)"
      },
      {
        "command": "bino.registryPublish",
        "title": "Publish Package",
        "category": "Bino",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "bino.newDataSourceFromFile",
        "title": "New DataSource from File…",
        "category": "Bino",
        "icon": "$(database)"
      },
      {
        "command": "bino.newDataSourceFromDatabase",
        "title": "New DataSource from Database…",
        "category": "Bino",
        "icon": "$(database)"
      },
      {
        "command": "bino.restartDaemon",
        "title": "Restart Daemon",
        "category": "Bino",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bino.refreshIndex",
        "title": "Refresh Index",
        "category": "Bino",
        "icon": "$(refresh)"
      },
      {
        "command": "bino.openDocument",
        "title": "Open Document",
        "category": "Bino"
      },
      {
        "command": "bino.openInlineChild",
        "title": "Open Component",
        "category": "Bino"
      },
      {
        "command": "bino.startPreview",
        "title": "Start Preview",
        "category": "Bino",
        "icon": "$(play)"
      },
      {
        "command": "bino.stopPreview",
        "title": "Stop Preview",
        "category": "Bino",
        "icon": "$(debug-stop)"
      },
      {
        "command": "bino.restartPreview",
        "title": "Restart Preview",
        "category": "Bino",
        "icon": "$(debug-restart)"
      },
      {
        "command": "bino.openPreviewInBrowser",
        "title": "Open Preview in Browser",
        "category": "Bino",
        "icon": "$(link-external)"
      },
      {
        "command": "bino.openPreviewInWebview",
        "title": "Open Preview in Webview",
        "category": "Bino",
        "icon": "$(window)"
      },
      {
        "command": "bino.previewMenu",
        "title": "Preview Menu",
        "category": "Bino"
      },
      {
        "command": "bino.build",
        "title": "Build Report",
        "category": "Bino",
        "icon": "$(package)"
      },
      {
        "command": "bino.checkSetup",
        "title": "Check Setup",
        "category": "Bino",
        "icon": "$(info)"
      },
      {
        "command": "bino.showColumnsForCurrentDataset",
        "title": "Show Columns for Current Dataset/DataSource",
        "category": "Bino",
        "icon": "$(list-flat)"
      },
      {
        "command": "bino.openFirstProblem",
        "title": "Go to First Problem",
        "category": "Bino",
        "icon": "$(error)"
      },
      {
        "command": "bino.showGraphForItem",
        "title": "Show Graph (Dependencies & Dependents)",
        "category": "Bino",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "bino.showDependenciesForItem",
        "title": "Show Dependencies",
        "category": "Bino",
        "icon": "$(arrow-down)"
      },
      {
        "command": "bino.showDependentsForItem",
        "title": "Show Dependents (What Uses This?)",
        "category": "Bino",
        "icon": "$(arrow-up)"
      },
      {
        "command": "bino.openPrqlEditor",
        "title": "Open PRQL Editor",
        "category": "Bino",
        "icon": "$(code)"
      },
      {
        "command": "bino.openPrqlSqlPreview",
        "title": "Open PRQL SQL Preview",
        "category": "Bino",
        "icon": "$(open-preview)"
      },
      {
        "command": "bino.previewRows",
        "title": "Preview Rows (100 rows)",
        "category": "Bino",
        "icon": "$(preview)"
      },
      {
        "command": "bino.openTreeEditor",
        "title": "Open Tree Editor",
        "category": "Bino",
        "icon": "$(list-tree)"
      },
      {
        "command": "bino.openDesigner",
        "title": "Open Designer",
        "category": "Bino",
        "icon": "$(edit)"
      },
      {
        "command": "bino.openInDesigner",
        "title": "Open in Designer",
        "category": "Bino",
        "icon": "$(edit)"
      },
      {
        "command": "bino.addElement",
        "title": "Add Element",
        "category": "Bino",
        "icon": "$(add)"
      },
      {
        "command": "bino.initProject",
        "title": "Initialize Project",
        "category": "Bino"
      },
      {
        "command": "bino.addDataset",
        "title": "Add DataSet",
        "category": "Bino"
      },
      {
        "command": "bino.addDatasource",
        "title": "Add DataSource",
        "category": "Bino"
      },
      {
        "command": "bino.addConnectionSecret",
        "title": "Add ConnectionSecret",
        "category": "Bino"
      },
      {
        "command": "bino.addLayoutPage",
        "title": "Add LayoutPage",
        "category": "Bino"
      },
      {
        "command": "bino.addLayoutCard",
        "title": "Add LayoutCard",
        "category": "Bino"
      },
      {
        "command": "bino.addTable",
        "title": "Add Table",
        "category": "Bino"
      },
      {
        "command": "bino.addText",
        "title": "Add Text",
        "category": "Bino"
      },
      {
        "command": "bino.addChartStructure",
        "title": "Add ChartStructure",
        "category": "Bino"
      },
      {
        "command": "bino.addChartTime",
        "title": "Add ChartTime",
        "category": "Bino"
      },
      {
        "command": "bino.addChartScatter",
        "title": "Add ChartScatter",
        "category": "Bino"
      },
      {
        "command": "bino.addChartBubble",
        "title": "Add ChartBubble",
        "category": "Bino"
      },
      {
        "command": "bino.addChartBullet",
        "title": "Add ChartBullet",
        "category": "Bino"
      },
      {
        "command": "bino.addReportArtefact",
        "title": "Add ReportArtefact",
        "category": "Bino"
      },
      {
        "command": "bino.addLiveReportArtefact",
        "title": "Add LiveReportArtefact",
        "category": "Bino"
      },
      {
        "command": "bino.addSigningProfile",
        "title": "Add SigningProfile",
        "category": "Bino"
      },
      {
        "command": "bino.addAsset",
        "title": "Add Asset",
        "category": "Bino"
      },
      {
        "command": "bino.addComponentStyle",
        "title": "Add ComponentStyle",
        "category": "Bino"
      },
      {
        "command": "bino.addInternationalization",
        "title": "Add Internationalization",
        "category": "Bino"
      },
      {
        "command": "bino.addScalingGroup",
        "title": "Add ScalingGroup",
        "category": "Bino"
      },
      {
        "command": "bino.cacheClean",
        "title": "Clean Cache",
        "category": "Bino"
      },
      {
        "command": "bino.cacheCleanGlobal",
        "title": "Clean Cache (Global)",
        "category": "Bino"
      },
      {
        "command": "bino.buildArtefact",
        "title": "Build Specific Artefact",
        "category": "Bino"
      },
      {
        "command": "bino.previewArtefactEmbedded",
        "title": "Preview (Embedded)",
        "category": "Bino",
        "icon": "$(preview)"
      },
      {
        "command": "bino.validateWithQueries",
        "title": "Validate with Queries",
        "category": "Bino"
      },
      {
        "command": "bino.showGraphTree",
        "title": "Show Graph (Tree)",
        "category": "Bino"
      },
      {
        "command": "bino.showGraphFlat",
        "title": "Show Graph (Flat)",
        "category": "Bino"
      },
      {
        "command": "bino.openSettings",
        "title": "Open Bino Settings",
        "category": "Bino"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bino.addElement",
          "when": "view == binoDocuments",
          "group": "navigation@0"
        },
        {
          "command": "bino.refreshIndex",
          "when": "view == binoDocuments",
          "group": "navigation@1"
        },
        {
          "command": "bino.registrySearch",
          "when": "view == binoDependencies",
          "group": "navigation@0"
        },
        {
          "command": "bino.registryUpdateAll",
          "when": "view == binoDependencies",
          "group": "navigation@1"
        },
        {
          "command": "bino.registryPublish",
          "when": "view == binoDependencies",
          "group": "navigation@2"
        },
        {
          "command": "bino.registryRefresh",
          "when": "view == binoDependencies",
          "group": "navigation@3"
        }
      ],
      "explorer/context": [
        {
          "command": "bino.newDataSourceFromFile",
          "when": "bino.projectDetected && resourceExtname =~ /\\.(csv|tsv|xlsx|xls|parquet)$/i",
          "group": "bino@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bino.registrySearch",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryAddDependency",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryInstall",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryUpdateAll",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryInsertRef",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryLogin",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryLogout",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryPublish",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.registryRefresh",
          "when": "false"
        },
        {
          "command": "bino.registryUpdatePackage",
          "when": "false"
        },
        {
          "command": "bino.registryRemovePackage",
          "when": "false"
        },
        {
          "command": "bino.registryOpenPackageFile",
          "when": "false"
        },
        {
          "command": "bino.registryCopyRef",
          "when": "false"
        },
        {
          "command": "bino.newDataSourceFromFile",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.newDataSourceFromDatabase",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.addElement",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.openInDesigner",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.addDataset",
          "when": "false"
        },
        {
          "command": "bino.addDatasource",
          "when": "false"
        },
        {
          "command": "bino.addConnectionSecret",
          "when": "false"
        },
        {
          "command": "bino.addLayoutPage",
          "when": "false"
        },
        {
          "command": "bino.addLayoutCard",
          "when": "false"
        },
        {
          "command": "bino.addTable",
          "when": "false"
        },
        {
          "command": "bino.addText",
          "when": "false"
        },
        {
          "command": "bino.addChartStructure",
          "when": "false"
        },
        {
          "command": "bino.addChartTime",
          "when": "false"
        },
        {
          "command": "bino.addChartScatter",
          "when": "false"
        },
        {
          "command": "bino.addChartBubble",
          "when": "false"
        },
        {
          "command": "bino.addChartBullet",
          "when": "false"
        },
        {
          "command": "bino.addReportArtefact",
          "when": "false"
        },
        {
          "command": "bino.addLiveReportArtefact",
          "when": "false"
        },
        {
          "command": "bino.addSigningProfile",
          "when": "false"
        },
        {
          "command": "bino.addAsset",
          "when": "false"
        },
        {
          "command": "bino.addComponentStyle",
          "when": "false"
        },
        {
          "command": "bino.addInternationalization",
          "when": "false"
        },
        {
          "command": "bino.addScalingGroup",
          "when": "false"
        },
        {
          "command": "bino.restartDaemon",
          "when": "bino.projectDetected"
        },
        {
          "command": "bino.openDocument",
          "when": "false"
        },
        {
          "command": "bino.openInlineChild",
          "when": "false"
        },
        {
          "command": "bino.previewMenu",
          "when": "false"
        },
        {
          "command": "bino.openFirstProblem",
          "when": "false"
        },
        {
          "command": "bino.openPrqlEditor",
          "when": "editorLangId == yaml"
        },
        {
          "command": "bino.openPrqlSqlPreview",
          "when": "editorLangId == yaml"
        },
        {
          "command": "bino.showGraphForItem",
          "when": "false"
        },
        {
          "command": "bino.showDependenciesForItem",
          "when": "false"
        },
        {
          "command": "bino.showDependentsForItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "bino.previewArtefactEmbedded",
          "when": "view == binoDocuments && viewItem == binoArtefact",
          "group": "preview@1"
        },
        {
          "command": "bino.openDesigner",
          "when": "view == binoDocuments && viewItem == binoArtefact",
          "group": "preview@2"
        },
        {
          "command": "bino.openFirstProblem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)$/",
          "group": "navigation"
        },
        {
          "command": "bino.showGraphForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)$/",
          "group": "graph@1"
        },
        {
          "command": "bino.showDependenciesForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)$/",
          "group": "graph@2"
        },
        {
          "command": "bino.showDependentsForItem",
          "when": "view == binoDocuments && viewItem =~ /^bino(Document|Artefact)$/",
          "group": "graph@3"
        },
        {
          "command": "bino.registryInsertRef",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@1"
        },
        {
          "command": "bino.registryCopyRef",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@2"
        },
        {
          "command": "bino.registryOpenPackageFile",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "use@3"
        },
        {
          "command": "bino.registryUpdatePackage",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "manage@1"
        },
        {
          "command": "bino.registryRemovePackage",
          "when": "view == binoDependencies && viewItem == binoPackage",
          "group": "manage@2"
        }
      ],
      "editor/title": [
        {
          "command": "bino.openTreeEditor",
          "when": "editorLangId == yaml && bino.projectDetected",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bino.openInDesigner",
          "when": "editorLangId == yaml && bino.projectDetected",
          "group": "bino@0"
        },
        {
          "command": "bino.openPrqlEditor",
          "when": "editorLangId == yaml && bino.inPrqlBlock",
          "group": "bino@1"
        },
        {
          "command": "bino.openPrqlSqlPreview",
          "when": "editorLangId == yaml && bino.inPrqlBlock",
          "group": "bino@2"
        }
      ]
    },
    "configuration": {
      "title": "Bino Reports",
      "properties": {
        "bino.binPath": {
          "type": "string",
          "default": "",
          "description": "Path to the bino CLI executable. If not set, uses 'bino' from PATH."
        },
        "bino.columnCacheTTL": {
          "type": "number",
          "default": 60000,
          "description": "Time in milliseconds to cache column introspection results (default: 60 seconds)."
        },
        "bino.previewPort": {
          "type": "number",
          "default": 3000,
          "description": "Port number for the bino preview server."
        },
        "bino.daemon.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent background daemon for faster indexing, validation, and data introspection. The daemon shares a single DuckDB session across operations."
        },
        "bino.wizard.sampleRowLimit": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of sample rows the DataSource wizard fetches when introspecting a source."
        }
      }
    }
  },
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.61.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "yaml": "^2.9.0"
  }
}

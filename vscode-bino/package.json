{
  "name": "vscode-bino",
  "displayName": "Bino Reports",
  "description": "Enhanced YAML editing for Bino report manifests with intelligent autocompletion",
  "version": "0.25.0",
  "license": "AGPL-3.0-or-later",
  "publisher": "BinoBI",
  "repository": {
    "type": "git",
    "url": "https://github.com/bino-bi/bino-cli-releases"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "yaml",
    "bino",
    "reports",
    "data"
  ],
  "activationEvents": [
    "workspaceContains:**/bino.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bino",
          "title": "Bino Reports",
          "icon": "resources/bino-activity-bar.svg"
        }
      ]
    },
    "views": {
      "bino": [
        {
          "id": "binoDocuments",
          "name": "Documents",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoPreview",
          "name": "Preview & Build",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoActions",
          "name": "Scaffolding",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoDependencies",
          "name": "Dependencies",
          "when": "bino.projectDetected"
        },
        {
          "id": "binoEnvironment",
          "name": "Environment",
          "when": "bino.projectDetected"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "binoDocuments",
        "contents": "No Bino project detected.\n[Initialize Project](command:bino.initProject)\n[Open Folder](command:vscode.openFolder)",
        "when": "!bino.projectDetected"
      }
    ],
    "commands": [
